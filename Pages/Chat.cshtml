@page
@model ZoZoom.Pages.ChatModel
@{
    ViewData["Title"] = "Chat";
}

<div class="row">
    <div class="col-md-3">
        <h3>Rooms</h3>
        <input type="text" id="groupNameBox" class="form-control mb-2" placeholder="Group/Meeting Name" />
        <button id="joinGroupBtn" class="btn btn-secondary w-100">Join Group</button>
    </div>

    <div class="col-md-9">
        <div id="chatBox" class="border p-3 mb-3" style="height: 400px; overflow-y: scroll;">
            <ul id="messagesList" class="list-unstyled"></ul>
        </div>

        <div class="input-group">
            <input type="file" id="fileInput" class="form-control" style="max-width: 250px;" />
            <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
            <button id="sendBtn" class="btn btn-primary">Send</button>
        </div>
    </div>
</div>

<!-- Load SignalR client from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/chatHub")
    .build();

    connection.on("ReceiveMessage", (user, message, fileUrl, group) => {
    const li = document.createElement("li");
    let content = `<strong>${user}</strong> [${group}]: ${message}`;
    if (fileUrl) {
    content += `<br><a href="${fileUrl}" target="_blank">Attachment</a>`;
    }
    li.innerHTML = content;
    document.getElementById("messagesList").appendChild(li);
    document.getElementById("chatBox").scrollTop = document.getElementById("chatBox").scrollHeight;
    });

    connection.on("SystemMessage", (message) => {
    const li = document.createElement("li");
    li.innerHTML = `<em>${message}</em>`;
    document.getElementById("messagesList").appendChild(li);
    });

    document.getElementById("joinGroupBtn").addEventListener("click", () => {
    const group = document.getElementById("groupNameBox").value;
    connection.invoke("JoinGroup", group);
    });

    document.getElementById("sendBtn").addEventListener("click", async () => {
    const group = document.getElementById("groupNameBox").value;
    const msg = document.getElementById("messageInput").value;
    const fileInput = document.getElementById("fileInput");
    
    let fileUrl = null;

    // 1. Handle file upload if a file is selected
    if (fileInput.files.length > 0) {
        const formData = new FormData();
        formData.append("file", fileInput.files[0]);

        try {
            // Send the file to our new API endpoint
            const response = await fetch('/api/upload', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                const result = await response.json();
                fileUrl = result.url; // Get the generated URL from the server
                fileInput.value = ''; // Clear the file input
            } else {
                console.error("File upload failed.");
                alert("Failed to upload the file.");
                return; // Stop execution if upload fails
            }
        } catch (err) {
            console.error("Error uploading file:", err);
            return;
        }
    }

    // 2. Send the message and the fileUrl via SignalR
    // Only send if there is a text message OR an uploaded file
    if (msg.trim() !== '' || fileUrl !== null) {
        connection.invoke("SendGroupMessage", group, msg, fileUrl)
            .catch(err => console.error(err.toString()));
            
        // Clear the text input
        document.getElementById("messageInput").value = '';
    }
});

    connection.start().catch(err => console.error(err.toString()));
</script>