<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZoZoom</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --bg-color: #121212;
            --sidebar-bg: #1e1e1e;
            --text-color: #ffffff;
            --nav-link-color: #a0a0a0;
            --nav-link-hover: #333333;
            --border-color: #333333;
        }

        [data-theme="light"] {
            --bg-color: #f8f9fa;
            --sidebar-bg: #ffffff;
            --text-color: #212529;
            --nav-link-color: #495057;
            --nav-link-hover: #e9ecef;
            --border-color: #dee2e6;
        }

        .app-wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
            background-color: var(--bg-color);
            transition: background-color 0.3s ease;
        }

        .app-sidebar {
            width: 260px;
            background-color: var(--sidebar-bg);
            color: var(--text-color);
            display: flex;
            flex-direction: column;
            padding: 20px;
            border-right: 1px solid var(--border-color);
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }

            .app-sidebar h3 {
                margin-bottom: 30px;
                font-weight: bold;
                color: var(--text-color);
            }

        .nav-link {
            color: var(--nav-link-color);
            text-decoration: none;
            padding: 12px 15px;
            margin-bottom: 10px;
            border-radius: 8px;
            transition: all 0.2s ease-in-out;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .nav-link:hover, .nav-link.active {
                background-color: var(--nav-link-hover);
                color: var(--text-color);
            }

        .theme-toggle-btn {
            margin-top: auto;
            background: none;
            border: none;
            color: var(--nav-link-color);
            padding: 12px 15px;
            border-radius: 8px;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s ease-in-out;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .theme-toggle-btn:hover {
                background-color: var(--nav-link-hover);
                color: var(--text-color);
            }

        .app-main-content {
            flex-grow: 1;
            position: relative;
            background-color: var(--bg-color);
            transition: background-color 0.3s ease;
        }
    </style>
</head>
<body>

    <div class="app-wrapper">
        <nav class="app-sidebar">
            <h3>ZoZoom</h3>

            <a href="/Chat" class="nav-link">Text Chat</a>
            <a href="/Meeting" class="nav-link">Video Meetings</a>
            <a href="/Calendar" class="nav-link">Scheduler</a>

            <button id="themeToggle" class="theme-toggle-btn">
                Toggle Theme
            </button>
        </nav>

        <main class="app-main-content">
            @RenderBody()
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggleBtn = document.getElementById('themeToggle');
            const savedTheme = localStorage.getItem('app-theme') || 'dark';

            document.documentElement.setAttribute('data-theme', savedTheme);

            toggleBtn.addEventListener('click', () => {
                const currentTheme = document.documentElement.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('app-theme', newTheme);
            });

            
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.nav-link');

            navLinks.forEach(link => {
                if (link.getAttribute('href').toLowerCase() === currentPath.toLowerCase()) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>